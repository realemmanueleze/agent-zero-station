# Copy to .env. Values below are local defaults. Secrets stay empty until you set them.
# Fixture park works without OAuth, Nango, SMTP, or a model key.
# Local Compose publishes Postgres on 127.0.0.1:5435. Set the user and password from compose.yml.
STATION_DATABASE_URL=postgres://127.0.0.1:5435/station
PACK_DATABASE_URL=postgres://pack:pack@127.0.0.1:5432/pack
STATION_MASTER_KEY=
STATION_MASTER_KEY_PREV=
STATION_PUBLIC_URL=
STATION_CONTROL_TOKEN=
STATION_COCKPIT_PASSWORD=
STATION_COCKPIT_PORT=19173
STATION_WORKER_PORT=19174
NODE_ENV=development
STATION_GRAPH_TENANT_ID=
STATION_GRAPH_CLIENT_ID=
STATION_GRAPH_CLIENT_SECRET=
STATION_EMAIL_FROM=
STATION_IMAP_HOST=
STATION_IMAP_USER=
STATION_IMAP_PASS=
STATION_SMTP_HOST=
STATION_SMTP_PORT=587
STATION_SMTP_USER=
STATION_SMTP_PASS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
NANGO_SECRET_KEY=
NANGO_WEBHOOK_SECRET=
NANGO_HOST=
NANGO_INTEGRATION_EMAIL=google-mail
NANGO_INTEGRATION_SLACK=slack
NANGO_INTEGRATION_DRIVE=google-drive
LANGSMITH_API_KEY=
# T33 (not read yet): cheap default vs metered frontier. Today live turns use STATION_MODEL_KEY when set.
# STATION_MODEL=
# STATION_MODEL_FRONTIER=
