    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@station/observability": ["./packages/observability/src/index.ts"],
      "@station/api": ["./packages/station/src/index.ts"]
